# ---------------------------------------------------------
# EcosystemRadar - Environment Variables Template
# Copy this file to .env and fill in the values
# ---------------------------------------------------------

# Server
PORT=8080
CRON_SECRET=super_secret_cron_trigger_string

# APIs
GEMINI_API_KEY=your_gemini_flash_api_key
CMC_API_KEY=your_coinmarketcap_api_key

# Supabase Database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# Notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Agent Wallet & Payments (x402 & Clawpump)
AGENT_WALLET_ADDRESS=your_solana_or_base_wallet_address
AGENT_WALLET_PRIVATE_KEY=your_private_key_secure_in_tee
